# Host folders mounted into the container.
DATA_DIR=./data
DOWNLOADS_DIR=./downloads

# Optional fail-closed marker inside a required host mount. For the Matrix
# RAID deployment this is /downloads/.telegram-downloader-mounted.
# DOWNLOAD_MOUNT_MARKER=

# Set these to the host user's UID/GID when the mapped download directory is
# owned by that user. The image default is 10001:10001.
# PUID=10001
# PGID=10001

# tdl account namespace. Keep this stable so the login/session is reusable.
TDL_NS=default

# Optional override for the account folder name. init normally detects this.
# TDL_USER_ID=

# Version baked into the image.
TDL_VERSION=v0.20.2

# Optional tdl proxy, for example socks5://user:password@host:1080.
# TDL_PROXY=

# Time tdl keeps trying to reconnect inside one process. Use 0 for infinite.
TDL_RECONNECT_TIMEOUT=10m

# Optional NTP server for Telegram client time checks.
# TDL_NTP=pool.ntp.org

# Delay between wrapper retries after tdl exits with an error, in seconds.
DOWNLOAD_RETRY_GAP_SECONDS=300

# Used by the daily scheduler and log timestamps.
TZ=Asia/Shanghai
LOG_LEVEL=INFO
